{
  "expo": {
    "name": "Nova Ardiansyah",
    "slug": "personal-v4",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "personalv4",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.novaardiansyah.personalv4",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan aplikasi mengakses galeri foto Anda untuk memperbarui avatar profil.",
          "cameraPermission": "Izinkan aplikasi mengakses kamera Anda untuk mengambil foto profil baru."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-status-bar": {
        "style": "dark"
      },
      "eas": {
        "projectId": "5818a72b-48fe-455f-9e02-3d2e615b9d6d"
      }
    },
    "owner": "novaardiansyah"
  }
}
